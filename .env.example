TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token

# Required. Numeric Telegram user IDs allowed to use the bot, separated by commas
# (e.g. 111111111,222222222). Every listed person can use it and gets every
# message. Each must press Start in the bot's chat once to receive messages.
BOT_OWNER_ID=

# Required. Encrypts the saved Razer login, backup codes and progress in data/.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the saved state unreadable.
BOT_SECRET_KEY=

# Minutes between automatic purchase checks.
CHECK_INTERVAL_MINUTES=30

# Browser settings
RAZER_HEADLESS=true
RAZER_ACCOUNT_URL=https://gold.razer.com/account-summary/
RAZER_LOGIN_TIMEOUT_MS=120000

# Save a screenshot + HTML of each purchase step into debug/ (contains
# account details; keep it local).
RAZER_DEBUG_SNAPSHOTS=false

# Optional Telegram HTTP/SOCKS proxy.
TELEGRAM_PROXY_URL=

# Get new backup codes from Razer ID automatically when this many are left.
BACKUP_CODES_REFRESH_AT=2

# Time zone for times shown in /status and messages (Docker), e.g. Asia/Karachi.
TZ=UTC

# Send a Telegram message after EVERY check (default: true), so you can see
# the 30-minute timer working. Set false to hear only about changes: bought,
# order done, a new problem.
NOTIFY_EVERY_CHECK=true
