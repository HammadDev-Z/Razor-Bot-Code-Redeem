TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token

# Strongly recommended. Only this numeric Telegram user ID can use /login.
BOT_OWNER_ID=

# Browser settings
RAZER_HEADLESS=true
RAZER_ACCOUNT_URL=https://gold.razer.com/account-summary/
